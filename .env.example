# ---- Site ----
# Used for absolute OG image URLs and Cashfree return/notify URLs.
NEXT_PUBLIC_SITE_URL=https://deservv.com

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments ----
# "cashfree" or "razorpay". Leave as razorpay until Cashfree keys are live.
NEXT_PUBLIC_PAYMENT_PROVIDER=razorpay

# Cashfree (Dashboard -> Developers -> API Keys)
# CASHFREE_MODE: "sandbox" while testing, "production" once activated.
CASHFREE_MODE=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Razorpay (legacy, still the default provider)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Program ----
COHORT_CAPACITY=24
